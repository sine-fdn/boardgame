# Reference for the environment variables this app reads. Set them however
# your deployment does that (a .env file, CI/CD secrets, systemd, ...).
#
# Values marked SECRET below show the shape of a real value, not one to
# reuse: generate your own.

# ─── Image ──────────────────────────────────────────────────────────────────────
# Which image to run. IMAGE_TAG is the rollback lever: point it at a
# `sha-<short>` tag to pin an exact build, or `latest` to track the newest
# main build.
IMAGE=ghcr.io/sine-fdn/boardgame
IMAGE_TAG=latest

# ─── Ports ──────────────────────────────────────────────────────────────────────
# Host port the app is published on. Optional, defaults to 8000. The port
# *inside* the container is fixed at 8000 (see Dockerfile's EXPOSE).
OTREE_HOST_PORT=8000

# Which host interface to publish on. Optional, defaults to 0.0.0.0. Use
# 127.0.0.1 when a reverse proxy on the host itself handles external traffic.
OTREE_BIND_ADDR=0.0.0.0

# ─── oTree admin ───────────────────────────────────────────────────────────────
# Username for the oTree admin interface (/admin). Optional, defaults to
# "admin" if unset.
OTREE_ADMIN_USERNAME=admin

# SECRET. Password for the oTree admin interface. Mandatory: the app fails to
# start without it. Generate one with: openssl rand -base64 24
OTREE_ADMIN_PASSWORD=6GLyFDotmp51QPrwZSwAslAmZnbpashW

# ─── Django ─────────────────────────────────────────────────────────────────────
# SECRET. Django secret key (session signing, CSRF, ...). Mandatory: the app
# fails to start without it. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
OTREE_SECRET_KEY=aNm3tBJ6TaHyNJeFPta0Cbp3ljqOnI5SQLWDovnf_QauxpJmxQa1Sl6-kg1tIXxe-iM

# ─── REST API ───────────────────────────────────────────────────────────────────
# SECRET. Authenticates REST API requests from the site that embeds this game
# (the oepgv-docs repo's own OTREE_REST_KEY) — the two must be the identical
# value. Generate one with: openssl rand -hex 32
OTREE_REST_KEY=c0c8bf81ff4d27fc1930ce833421fdc27f7691b7a3f3e04c78c3cf565482e513

# ─── Database ───────────────────────────────────────────────────────────────────
# SECRET (embeds a password). Where oTree stores its data. Optional: if
# unset, docker-compose.yml builds this automatically from POSTGRES_USER/
# POSTGRES_PASSWORD/POSTGRES_DB below, pointing at the bundled `postgres`
# service. Set this explicitly only to point at a different database
# instead, e.g. an external managed one.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# DATABASE_URL=postgresql://otree:357fa50c9200830f7e6dc8f11518b1d2996cca119a851583@postgres:5432/otree

# ─── Bundled Postgres (docker-compose "postgres" service) ─────────────────────
# Configure the local Postgres container defined in docker-compose.yml.
# Required by Compose either way; also used to build the default
# DATABASE_URL above when that's left unset.
POSTGRES_USER=otree

# SECRET. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=357fa50c9200830f7e6dc8f11518b1d2996cca119a851583

POSTGRES_DB=otree
